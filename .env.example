# Copy to .env and adjust as needed (or export these directly in your shell).
# None of these are required for the default local/manual setup - script.py
# uses the Claude Code CLI (`claude -p`) with your existing subscription, and
# Piper needs no key. These are here for tuning and for the future CI path.

# --- Feed / hosting -----------------------------------------------------------
# Already set to real values as defaults in config.py - only set these here
# if you want to override them (e.g. testing under a different repo/URL).
# SITE_BASE_URL=https://tranner.github.io/arxiv-mathna-podcast
# PODCAST_TITLE=arXiv Numerical Analysis Daily (Beta)
# PODCAST_AUTHOR=Tom Ranner
# PODCAST_EMAIL=T.Ranner@leeds.ac.uk

# --- Episode tuning -----------------------------------------------------------
# TARGET_MINUTES=15
# DEEP_DIVE_MIN=1
# DEEP_DIVE_MAX=3
# HOST_A_NAME=Alex
# HOST_B_NAME=Sam
# HOST_A_VOICE=en_GB-northern_english_male-medium
# HOST_B_VOICE=en_GB-cori-high

# --- CI / automation (deferred - see README "Automating the daily run") -----
# SCRIPT_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
