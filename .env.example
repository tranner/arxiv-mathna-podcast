# Copy to .env and adjust as needed (or export these directly in your shell).
# None of these are required for the default local/manual setup - script.py
# uses the Claude Code CLI (`claude -p`) with your existing subscription, and
# Piper needs no key. These are here for tuning and for the future CI path.

# --- Feed / hosting (set these correctly before publishing for real) --------
SITE_BASE_URL=https://your-github-username.github.io/arxiv-podcast
PODCAST_TITLE=arXiv Numerical Analysis Daily
PODCAST_AUTHOR=your-name
PODCAST_EMAIL=you@example.com

# --- Episode tuning -----------------------------------------------------------
# TARGET_MINUTES=15
# DEEP_DIVE_MIN=1
# DEEP_DIVE_MAX=3
# HOST_A_NAME=Alex
# HOST_B_NAME=Sam
# HOST_A_VOICE=en_GB-jenny_dioco-medium
# HOST_B_VOICE=en_GB-cori-high

# --- CI / automation (deferred - see README "Automating the daily run") -----
# SCRIPT_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
